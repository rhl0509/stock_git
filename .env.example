# .env.example — 환경변수 템플릿
# 이 파일을 복사해 `.env`로 만들고 각 값을 실제 값으로 채우세요.  cp .env.example .env
# 주의: 실제 .env 는 절대 커밋하지 마세요(.gitignore 에 이미 제외됨).

# ── 데이터베이스 (MySQL) ──
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=__CHANGE_ME__
DB_NAME=stock_stack

# ── 보안 ──
# 세션 서명 키. 무작위 32바이트 hex 권장:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=__CHANGE_ME_RANDOM_HEX__

# ── 인코딩 (Windows 한글 깨짐 방지) ──
PYTHONIOENCODING=utf-8
PYTHONUTF8=1

# ── 서버 포트 ──
PORT=5099

# ── 스케줄러 ──
# 멀티 워커/공개 배포 시 false 로 끄고 스케줄러는 별도 단일 프로세스로 분리할 것.
RUN_SCHEDULER=true

# ── 비밀번호 재설정 링크 베이스 URL (운영 시 공인 도메인으로) ──
APP_BASE_URL=http://localhost:5099

# ── 에이전트 리포트 LLM (Ollama 로컬 모델) ──
REPORT_LLM_MODEL=llama3.2:latest

# ── KRX (한국거래소) ──
KRX_ID=__CHANGE_ME__
KRX_PW=__CHANGE_ME__

# ── DART 전자공시  https://opendart.fss.or.kr/ ──
DART_API_KEY=__CHANGE_ME__

# ── 한국투자증권(KIS)  https://securities.koreainvestment.com/ ──
KIS_APP_KEY=__CHANGE_ME__
KIS_APP_SECRET=__CHANGE_ME__
KIS_ACCOUNT_NO=__CHANGE_ME__

# ── 한국은행 ECOS  https://ecos.bok.or.kr/api/ ──
BOK_API_KEY=__CHANGE_ME__

# ── Alpha Vantage  https://www.alphavantage.co/support/#api-key ──
ALPHA_VANTAGE_API_KEY=__CHANGE_ME__

# ── Finnhub  https://finnhub.io/dashboard ──
FINNHUB_API_KEY=__CHANGE_ME__

# ── Financial Modeling Prep ──
FMP_API_KEY=__CHANGE_ME__

# ── FRED  https://fredaccount.stlouisfed.org/apikey ──
FRED_API_KEY=__CHANGE_ME__

# ── 네이버 개발자  https://developers.naver.com/ ──
NAVER_CLIENT_ID=__CHANGE_ME__
NAVER_CLIENT_SECRET=__CHANGE_ME__

# ── 카카오  https://developers.kakao.com/ ──
KAKAO_REST_API_KEY=__CHANGE_ME__
KAKAO_CLIENT_SECRET=__CHANGE_ME__
KAKAO_REFRESH_TOKEN=__CHANGE_ME__
KAKAO_ACCESS_TOKEN=__CHANGE_ME__

# ── 알림 채널: telegram(기본) | kakao ──
NOTIFY_CHANNEL=telegram

# ── 관세청 수출입 통계  https://www.data.go.kr/ ──
CUSTOMS_API_KEY=__CHANGE_ME__

# ── 포트원(PortOne) 결제 ──
# 비워두면 크레딧 충전이 mock 모드로 동작(실결제 없이 충전 성공 처리).
# 포트원 콘솔(admin.portone.io) → 결제연동에서 발급.
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
# 웹훅 서명 검증 시크릿(whsec_...). 포트원 콘솔 → 웹훅에서 발급. 비우면 웹훅을 전부 거부한다.
# 실결제 전환 시 결제완료 통지(창 닫힘 대비 안전망)를 받으려면 반드시 설정.
PORTONE_WEBHOOK_SECRET=

# ── Claude(유료) AI 챗봇 ──
# 비워두면 챗봇 비활성화. 키를 넣으면 호출당 크레딧 차감.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-4-5
CHAT_CREDIT_COST=100
ADVISOR_CREDIT_COST=500

# ── AI 추천 데이 패스 ──
# 하루 1회 차감 크레딧 + 하루 경계 시각(KST). RESET_HOUR=7 → 07:00~다음날 07:00.
RECOMMEND_PASS_COST=1000
RECOMMEND_PASS_RESET_HOUR=7

# ── 소유자 게이트 (실계좌·자동화의 단일 소유자) ──
# 키움/KIS 실계좌 데이터와 자동화 잡(배당 기록·가계부 연동)의 대상 회원 id.
# 미설정 시 fail-closed: 소유자 전용 API 는 403, 자동화 잡은 스킵, 가계부 아웃박스는
# 전량 skipped 로 적재된다(전송 안 함). members 테이블의 본인 id 를 넣는다.
OWNER_USER_NO=

# ── 가계부(expense_tracker) 자동기록 연동 ──
# 매매·배당을 별도 가계부 앱에 자동 기록한다. 토큰은 가계부에서 발급받는다
# (가계부 POST /integration/tokens → 평문 1회 표시 → 여기에 붙여넣기).
# BASE_URL 기본 127.0.0.1:5000 — 평문 토큰을 로컬 루프백 밖으로 내보내지 않는다.
GAGEBU_BASE_URL=http://127.0.0.1:5000
GAGEBU_INGEST_TOKEN=

# ── 오프사이트 백업 대상 (선택) ──
# DB 덤프 + git bundle 을 미러링할 폴더(예: OneDrive). 미설정 시 백업 잡이 기본
# 경로를 시도하다 실패할 수 있으므로 본인 환경 경로를 명시하는 것을 권장.
OFFSITE_BACKUP_DIR=
