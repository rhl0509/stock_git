# ── 비밀정보 ──
.env
*.env
!.env.example

# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/

# ── Node ──
node_modules/

# ── 데이터/모델/캐시 (대용량·재생성 가능) ──
cache/
data/
logs/
backup/
# DB 덤프(회원 데이터 포함) — 절대 커밋 금지
_db_backup/
# CatBoost 학습 로그
catboost_info/
XGBoost_v2/data/
# 아래 *.cbm 등은 model/ 직속만 매칭하고 하위 폴더는 안 걸린다. 밑줄로 시작하는
# model 하위 폴더는 전부 백업/절제/작업 폴더다(_backup_/_ablation_/_pit_result_/
# _pre_purge_ 등, 재학습마다 새 이름). 밑줄 접두로 한 번에 제외한다.
# 정상 산출물 폴더(recommend_history 등)는 밑줄이 없어 안 걸린다.
XGBoost_v2/model/_*/
XGBoost_v2/model/*.cbm
XGBoost_v2/model/*.pkl
XGBoost_v2/model/*.txt
XGBoost_v2/model/xgb_*.json
XGBoost_v2/model/lgb_*.txt
XGBoost_v2/model/recommend_history/
XGBoost_v2/model/recommend_history_abs/
XGBoost_v2/model/daily_recommend*.json
XGBoost_v2/model/ml_lr_cache.json
trading/model/

# ── 빌드 산출물 ──
static/spa/

